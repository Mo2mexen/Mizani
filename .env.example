# Copy to .env to change these. Without a .env, the defaults below are used.

# Model the agent uses. The default fits a 4 GB GPU or a 16 GB Mac and is the one we evaluated.
# A larger model on a stronger machine is a one-line change here (e.g. qwen3.5:9b-q4_K_M,
# 8 GB GPU); speed and chart-sign accuracy depend on the model, the safety checks do not.
LLM_MODEL=qwen3.5:4b-q4_K_M

# OpenAI-compatible endpoint the agent calls.
# Default: the ollama service inside compose.
# Ollama installed on this machine instead: http://host.docker.internal:11434/v1
# With any address but the default, compose does not download the model: that server has it.
# Another machine on the LAN (docs/REMOTE_MODEL.md): http://<its-ip>:11434/v1
LLM_BASE_URL=http://ollama:11434/v1

# Thinking off on every request. Ollama needs "none"; leave it empty for a server that
# rejects the field (some hosted OpenAI-compatible APIs).
LLM_REASONING_EFFORT=none

# Key for a model server that checks one (vLLM, llama.cpp with --api-key). Ollama needs none.
# Complaint text goes to the server LLM_BASE_URL names, so keep that server on your own network.
# LLM_API_KEY=

# The agent's second look: the model sees what the server made of its chart signs and corrects
# or withdraws them once (docs/systems/agent.md). Off by default; 1 turns it on. It costs one
# more short model call for each patient whose complaint shows a chart sign.
# MIZANI_SECOND_LOOK=1

# The triage chart the MCP server scores with: the name of a rule pack file in
# src/mizani/rules/ without .yaml. Default: sats_adult (the adult South African Triage Scale).
# The server refuses a pack in which a clinical rule does not cite one of the pack's sources.
# Our evaluation (docs/EVALS.md) was run on sats_adult only.
# MIZANI_RULE_PACK=sats_adult

# Our MCP server, as the agent reaches it.
# Default: the mizani-mcp service inside compose. Outside Docker: http://127.0.0.1:8000/mcp
MIZANI_MCP_URL=http://mizani-mcp:8000/mcp

# wso2 fhir-mcp-server for the agent's FHIR output (unset: no FHIR output).
# Inside compose: http://fhir-mcp:8000/mcp/   Outside Docker: http://127.0.0.1:8001/mcp/  (keep the trailing slash)
MIZANI_FHIR_MCP_URL=http://fhir-mcp:8000/mcp/

# Signs the approval tokens; the model never sees it. Leave it unset: on the first start the
# server makes a secret of this install's own, in the data volume the API and the MCP server
# share. Set it only to choose your own (long and random; both servers get the same one).
# MIZANI_APPROVAL_SECRET=

# The names the nurse's page may be opened with, comma-separated. A request addressed to any
# other name is refused, so a web page elsewhere cannot reach Mizani through the nurse's browser
# (DNS rebinding). A ward server that others open by its own address adds that address here.
# MIZANI_ALLOWED_HOSTS=127.0.0.1,localhost

# Ports on this machine (all bound to 127.0.0.1). Change one if another program already uses it;
# the page is then at http://127.0.0.1:<API_HOST_PORT>.
# API_HOST_PORT=8090
# MCP_HOST_PORT=8000
# FHIR_MCP_HOST_PORT=8001
# HAPI_HOST_PORT=18080
