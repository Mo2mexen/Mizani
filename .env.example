# Copy to .env to change these. Without a .env, the defaults below are used.

# Model the agent uses. The default fits a 4 GB GPU or a 16 GB Mac and is the one we evaluated.
# A larger model on a stronger machine is a one-line change here (e.g. qwen3.5:9b-q4_K_M,
# 8 GB GPU); speed and chart-sign accuracy depend on the model, the safety checks do not.
LLM_MODEL=qwen3.5:4b-q4_K_M

# OpenAI-compatible endpoint the agent calls.
# Default: the ollama service inside compose.
# Ollama installed on this machine instead: http://host.docker.internal:11434/v1
# Another machine on the LAN (docs/REMOTE_MODEL.md): http://<its-ip>:11434/v1
LLM_BASE_URL=http://ollama:11434/v1

# Thinking off on every request. Ollama needs "none"; leave it empty for a server that
# rejects the field (some hosted OpenAI-compatible APIs).
LLM_REASONING_EFFORT=none

# Our MCP server, as the agent reaches it.
# Default: the mizani-mcp service inside compose. Outside Docker: http://127.0.0.1:8000/mcp
MIZANI_MCP_URL=http://mizani-mcp:8000/mcp

# wso2 fhir-mcp-server for the agent's FHIR output (unset: no FHIR output).
# Inside compose: http://fhir-mcp:8000/mcp/   Outside Docker: http://127.0.0.1:8001/mcp/  (keep the trailing slash)
MIZANI_FHIR_MCP_URL=http://fhir-mcp:8000/mcp/

# Signs the nurse-approval tokens. The MCP server and the API must share it; the model never
# sees it. The default is public: change it on any shared machine (anyone who knows it and can
# reach the ports could forge an approval).
MIZANI_APPROVAL_SECRET=local-demo-secret-change-me

# Ports on this machine (all bound to 127.0.0.1). Change one if another program already uses it;
# the page is then at http://127.0.0.1:<API_HOST_PORT>.
# API_HOST_PORT=8090
# MCP_HOST_PORT=8000
# FHIR_MCP_HOST_PORT=8001
# HAPI_HOST_PORT=18080
