# Copy to .env to change these. Without a .env, the defaults below are used.

# Model the agent uses. Default fits a 4 GB GPU or a 16 GB Mac.
# Desktop GPU with 8 GB or more: qwen3.5:9b-q4_K_M
LLM_MODEL=qwen3.5:4b-q4_K_M

# OpenAI-compatible endpoint the agent calls.
# Default: the ollama service inside compose.
# Ollama installed on this machine instead: http://host.docker.internal:11434/v1
# Another machine on the LAN (docs/REMOTE_MODEL.md): http://<its-ip>:11434/v1
LLM_BASE_URL=http://ollama:11434/v1

# Signs the nurse-approval tokens. The MCP server and the API must share it; the model never
# sees it. Set your own value for any shared machine.
MIZANI_APPROVAL_SECRET=local-demo-secret-change-me
